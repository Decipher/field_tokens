<?php

/**
 * @file
 * Core functions for the Field tokens module.
 */

declare(strict_types=1);

use Drupal\Core\Hook\Attribute\LegacyHook;
use Drupal\field_tokens\Hook\FieldTokensHooks;

/**
 * Implements hook_custom_formatters_token_data_alter().
 */
#[LegacyHook]
function field_tokens_custom_formatters_token_data_alter(array &$token_data, array $context): void {
  FieldTokensHooks::customFormattersTokenDataAlter($token_data, $context);
}
